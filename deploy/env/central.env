# Giá trị cho môi trường demo. KHÔNG đặt khóa thật ở đây; khóa nằm trong deploy/env/secrets/ (gitignore).
SPRING_PROFILES_ACTIVE=demo
SERVER_PORT=8080
DB_URL=jdbc:postgresql://postgres:5432/tmc
DB_USER=tmc
DB_PASSWORD=tmc

# API key của từng gate (thay cho mTLS) – phải khớp GATE_API_KEY trong gate-*.env
GATE_API_KEYS=gate-bd=demo-key-bd,gate-la=demo-key-la

# Để trống: profile demo tự sinh khóa Ed25519 khi khởi động. Muốn cố định thì chạy scripts/gen-keys.sh
TMC_QR_KEY_ID=k-demo
TMC_QR_SIGNING_KEY=
TMC_QR_PUBLIC_KEY=

QR_TOKEN_TTL=60s
QR_REFRESH_AFTER=30s
HEARTBEAT_OFFLINE_AFTER=30s
OFFLINE_THRESHOLD=2m
